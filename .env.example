# Ask AI (blume.config.ts の ai.ask.apiKeyEnv)
OLLAMA_API_KEY=

# News Editor — GitHub OAuth App(手動でGitHub Developer settingsから登録する)
# Callback URLは1アプリにつき1つしか登録できないため、本番用・開発用で
# 別々のOAuth Appを用意すること(開発用は http://localhost:8788/api/github/oauth/callback 等)。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# セッションcookieのHMAC署名鍵。`openssl rand -base64 32` 等で生成する。
SESSION_COOKIE_SECRET=

# News EditorがPRを作成する対象リポジトリ。開発時は使い捨てのテストリポジトリに向けること。
GITHUB_REPO_OWNER=ryukoku-math
GITHUB_REPO_NAME=math-site
GITHUB_REPO_BRANCH=main
