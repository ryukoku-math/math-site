---
// Wraps Blume's built-in Header to add a full-bleed cover photo right below
// it — outside `[data-blume-doc-grid]` entirely (the header renders directly
// in <body>, before the grid opens), so it spans the true viewport width
// exactly like the homepage's own banner, with no risk of overlapping the
// grid's right-rail nav/TOC column the way a banner nested inside the
// content column would.
import Header from "blume/components/layout/Header.astro";
import { getEntry } from "astro:content";
import data from "blume:data";

const props = Astro.props;
const route = props.route as string;

const MAIN_PAGE_COVERS: Record<string, string> = {
  "/about": "/images/covers/about.jpg",
  "/faculty": "/images/covers/faculty.jpg",
  "/research": "/images/covers/research.jpg",
  "/admission": "/images/covers/admission.jpg",
  "/videos": "/images/covers/videos.jpg",
};

const routeByPath = new Map(data.routes.map((r) => [r.path, r]));

// News banner image comes from the entry's own `seo.image` frontmatter —
// the same field pages/news/index.astro reads for the card thumbnail — so
// both places always agree on which image is best. Per-entry this is
// whichever of the Notion-fetched cover.* (a uniform ~512px-wide render,
// blurry once stretched into a banner) or the article's own inline photo
// (often 1000px+) is actually higher-resolution; picked by hand once when
// the mismatch was discovered rather than re-derived from disk here.
async function newsCoverFor(newsRoute: string): Promise<string | null> {
  if (!newsRoute.startsWith("/news/")) return null;
  const route = routeByPath.get(newsRoute);
  if (!route) return null;
  const entry = await getEntry(route.collection as "docs", route.entryId);
  return entry?.data.seo?.image ?? null;
}

const image = MAIN_PAGE_COVERS[route] ?? (await newsCoverFor(route));
---

<Header {...props} />
{
  image && (
    <div class="page-banner">
      <img src={image} alt="" loading="eager" />
    </div>
  )
}

<style>
  /*
   * Source covers (public/images/news/**\/cover.*) are only ~512px wide —
   * stretching them across the full viewport (often 1200px+) upscaled them
   * 2-3x and made them look visibly blurry. Capping the banner's width keeps
   * the upscale mild enough to stay crisp on ordinary displays.
   */
  .page-banner {
    width: 100%;
    max-width: 1024px;
    margin-inline: auto;
    height: 220px;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .page-banner {
      height: 280px;
    }
  }
  @media (min-width: 1024px) {
    .page-banner {
      height: 320px;
    }
  }
  .page-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
    display: block;
  }
</style>
